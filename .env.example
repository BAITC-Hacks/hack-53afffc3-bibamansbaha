EKT_API_BASE_URL=https://ekt.kz
EKT_API_USERNAME=
EKT_API_PASSWORD=
CATALOG_MODE=fixture
CATALOG_MAX_PAGES=2
CATALOG_OPERATION_TIMEOUT_MS=6000
OPENAI_API_KEY=
OPENAI_MODEL=
# Vercel: gpt-5.5; Responses reasoning=low is set server-side.
# PostgreSQL is mandatory on Vercel. Keep this URL server-side and never commit its value.
DATABASE_URL=
MODEL_BUDGET_MODE=demo
DEMO_BUDGET_PATH=
DEMO_BUDGET_MAX_CALLS=100
DEMO_BUDGET_MAX_USD=1
# Optional one-time deployment smoke allowance. Use an absolute persistent path outside the release.
# Unset path keeps local development behavior. Never delete/reset this ledger to renew the allowance.
MODEL_BUDGET_PATH=
MODEL_BUDGET_MAX_CALLS=6
MODEL_BUDGET_MAX_USD=0.25
DATABASE_PATH=.data/ekt.sqlite
APP_ORIGIN=http://127.0.0.1:3000
